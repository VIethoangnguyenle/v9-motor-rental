# ── Postgres ───────────────────────────────────────────────────────────
POSTGRES_USER=v9
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=v9_rental
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://v9:change_me_in_env@localhost:5432/v9_rental

# ── MinIO (S3-compatible) ──────────────────────────────────────────────
MINIO_ROOT_USER=v9admin
MINIO_ROOT_PASSWORD=change_me_in_env
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_VEHICLES=vehicles
MINIO_BUCKET_CHECKINS=checkins

# ── API ────────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# ── Frontends ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=vi
# apps/admin dùng Vite: chỉ biến có tiền tố VITE_ mới tới được client bundle.
VITE_API_URL=http://localhost:3001
ADMIN_PORT=3002
WEB_PORT=3000

# ── Caddy (prod) ───────────────────────────────────────────────────────
# web → v9.$ROOT_DOMAIN, api → api.$ROOT_DOMAIN, Directus → data.$ROOT_DOMAIN
# (data. không admin. — Directus chỉ giữ dữ liệu gốc, không phải admin app chính)
ROOT_DOMAIN=example.com
CADDY_EMAIL=you@example.com

# ── Directus (chỉ dữ liệu gốc) ─────────────────────────────────────────
# Kết nối bằng role directus_app: đọc/ghi DỮ LIỆU trong public, KHÔNG đổi được
# schema. Bảng hệ thống của nó nằm ở schema `directus`. Xem migration 0001.
DIRECTUS_DB_PASSWORD=directus_dev_only
DIRECTUS_KEY=thay_bang_chuoi_ngau_nhien_32_ky_tu
DIRECTUS_SECRET=thay_bang_chuoi_ngau_nhien_32_ky_tu
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change_me_in_env
DIRECTUS_PORT=8055

# ── SuperTokens (xác thực cho apps/staff) ──────────────────────────────
SUPERTOKENS_DB_PASSWORD=supertokens_dev_only
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=thay_bang_chuoi_ngau_nhien
API_DOMAIN=http://localhost:3001
STAFF_APP_URL=http://localhost:3003
STAFF_PORT=3003
VITE_API_URL=http://localhost:3001

# ── SEAM: JWT auth — CHƯA DÙNG ở phiên scaffold ────────────────────────
JWT_SECRET=unused_until_auth_is_implemented
