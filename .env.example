# ── Postgres ───────────────────────────────────────────────────────────
POSTGRES_USER=v9
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=v9_rental
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://v9:change_me_in_env@localhost:5432/v9_rental

# ── MinIO (S3-compatible) ──────────────────────────────────────────────
MINIO_ROOT_USER=v9admin
MINIO_ROOT_PASSWORD=change_me_in_env
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_VEHICLES=vehicles
MINIO_BUCKET_CHECKINS=checkins

# Khoá riêng của apps/api cho bucket `checkins` (ảnh bàn giao + ảnh giấy tờ).
# KHÔNG dùng MINIO_ROOT_* ở đây, cùng lý do đã ghi cho DIRECTUS_S3_*: service
# nào cũng chỉ nên mở được bucket của nó. Tạo bằng `mc admin user add` +
# `mc admin policy attach` — xem scripts/api-minio-policy.json.
API_S3_KEY=
API_S3_SECRET=

# ── API ────────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# ── Frontends ──────────────────────────────────────────────────────────
# apps/web (Next): mọi biến NEXT_PUBLIC_* bị NƯỚNG VÀO BUNDLE LÚC BUILD, y hệt
# VITE_* của staff — đặt lại lúc chạy KHÔNG có tác dụng, phải build lại image.
# Đo trên bản dựng: `process.env.NEXT_PUBLIC_API_URL` không còn trong chunk SSR
# nữa, chỉ còn hằng số ("http://localhost:3001"). Next thay nó lúc compile.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=vi
WEB_PORT=3000

# apps/staff (Vite): chỉ biến có tiền tố VITE_ mới tới được client bundle, và
# nó bị NƯỚNG VÀO BUNDLE LÚC BUILD — đổi giá trị này rồi restart container KHÔNG
# có tác dụng, phải build lại image. Xem CLAUDE.md.
VITE_API_URL=http://localhost:3001
STAFF_PORT=3003

# ── Caddy (prod) ───────────────────────────────────────────────────────
# web → v9.$ROOT_DOMAIN, api → api.$ROOT_DOMAIN, Directus → data.$ROOT_DOMAIN
# (data. không admin. — Directus chỉ giữ dữ liệu gốc, không phải admin app chính)
#
# ROOT_DOMAIN có HAI người dùng, không chỉ Caddy: apps/api cũng đọc nó để đặt
# `cookieDomain=".$ROOT_DOMAIN"` cho cookie session, để staff.$ROOT_DOMAIN gửi
# được cookie sang api.$ROOT_DOMAIN. Vế cookie CHỈ có tác dụng khi
# NODE_ENV=production (hàng rào ở apps/api/src/plugins/auth.ts, giữ bằng test) —
# nên để giá trị thật ở đây là vô hại cho dev, cookie dev vẫn host-only.
ROOT_DOMAIN=example.com
CADDY_EMAIL=you@example.com

# ── Directus (chỉ dữ liệu gốc) ─────────────────────────────────────────
# Kết nối bằng role directus_app: đọc/ghi DỮ LIỆU trong public, KHÔNG đổi được
# schema. Bảng hệ thống của nó nằm ở schema `directus`. Xem migration 0001.
DIRECTUS_DB_PASSWORD=directus_dev_only
DIRECTUS_KEY=thay_bang_chuoi_ngau_nhien_32_ky_tu
DIRECTUS_SECRET=thay_bang_chuoi_ngau_nhien_32_ky_tu
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change_me_in_env
DIRECTUS_PORT=8055

# Directus lưu ảnh vào MinIO qua S3 driver (compose.yaml / compose.prod.yaml,
# khối STORAGE_S3_*). DEV dùng thẳng MINIO_ROOT_USER/PASSWORD ở trên — chấp
# nhận được vì dev không phơi ra internet và volume MinIO ở dev vứt đi được.
#
# PROD KHÔNG dùng root: compose.prod.yaml đọc DIRECTUS_S3_KEY/SECRET (hai
# biến ngay dưới), KHÔNG phải MINIO_ROOT_*. Directus là service phơi ra
# internet nhiều nhất trong stack; cầm credential root thì một lỗ hổng
# trong Directus thành quyền toàn bộ object storage, kể cả bucket
# `checkins` (ảnh tình trạng xe lúc bàn giao — bằng chứng khi tranh chấp).
# Trước lần deploy VPS đầu tiên, chạy
# docs/runbooks/minio-directus-scoped-key.md để tạo access key MinIO riêng
# cho Directus — policy chỉ cho đọc/ghi bucket `vehicles`, không đụng
# `checkins` (policy JSON ở scripts/directus-minio-policy.json, đã kiểm cả
# hai chiều trên MinIO dev) — rồi điền kết quả vào hai biến dưới trên VPS.
# Để trống thì Directus trên VPS không upload/đọc được ảnh: thất bại rõ
# ràng lúc chạy, không phải lỗ hổng âm thầm.
# DIRECTUS_S3_KEY=
# DIRECTUS_S3_SECRET=

# apps/web dựng URL ảnh từ biến này. ĐỌC LÚC BUILD (next.config.ts dùng nó cho
# images.remotePatterns), nên đổi nó bắt buộc phải build lại image của web.
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# ── Directus, phía apps/api ──────────────────────────────────────────────────
# apps/api đẩy ẢNH XE lên Directus thay vì ghi thẳng MinIO: apps/web phục vụ ảnh
# qua /assets/<fileId>?key=web, nên một file không có hàng trong directus_files là
# một ảnh vỡ trên trang công khai. Khoá API_S3_KEY cũng cố ý không mở bucket
# `vehicles` (đã đo là Access Denied), nên đường ghi thẳng không tồn tại.
#
# DIRECTUS_API_TOKEN là token của tài khoản máy `apps-api@example.com`, role `api`,
# policy `api-files` — bốn hành động trên directus_files và không gì khác. KHÔNG
# dùng token admin ở đây: cùng lý lẽ đã đóng món nợ "Directus cầm credential ROOT
# của MinIO" trong docs/DEBT.md.
#
# `bun run directus:setup` đọc biến này và tạo/cập nhật tài khoản máy cho khớp.
# Đổi token thì sửa ở đây rồi chạy lại script; script sẽ THỬ DÙNG token cũ trước,
# nên chạy lại khi không đổi gì vẫn là no-op.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_API_TOKEN=thay_bang_chuoi_ngau_nhien_40_ky_tu

# URL Directus mà TRÌNH DUYỆT gọi, cho màn Đội xe của apps/staff (ảnh xe hiện qua
# /assets/<fileId>?key=web). KHÁC DIRECTUS_URL ở trên: cái kia là đường apps/api đi
# trong mạng docker. Vite nướng biến này lúc BUILD — đặt lúc chạy không có tác dụng.
VITE_DIRECTUS_URL=http://localhost:8055

# ── SuperTokens (xác thực cho apps/staff) ──────────────────────────────
SUPERTOKENS_DB_PASSWORD=supertokens_dev_only
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=thay_bang_chuoi_ngau_nhien
API_DOMAIN=http://localhost:3001
STAFF_APP_URL=http://localhost:3003

# ── Email (gửi mã đặt lại mật khẩu cho nhân viên) ──────────────────────
# THIẾU khối này thì API vẫn chạy: /staff/password-reset/request trả 503 và
# nhân viên phải nhờ OWNER phát mã. Không phải thứ chặn deploy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=V9 Motor Rental <no-reply@example.com>

# Mã đặt lại mật khẩu ở môi trường KHÔNG PHẢI production luôn là 999999.
# Biến dưới đây chỉ để ĐỔI GIÁ TRỊ đó khi cần test nhiều mã — nó KHÔNG phải
# công tắc bật/tắt. ⚠️ Có mặt nó ở NODE_ENV=production thì API KHÔNG KHỞI ĐỘNG.
# AUTH_DEV_OTP=999999

# Email của chủ shop, dùng cho `bun run staff:bootstrap` (xem Task 12).
STAFF_OWNER_EMAIL=chu-shop@example.com

# Mật khẩu chủ shop, dùng cho `bun run staff:bootstrap`. BẮT BUỘC khi
# NODE_ENV=production — thiếu thì script ném lỗi và không tạo/đụng account
# nào. Để trống ở dev thì script dùng mặc định `DoiMatKhauNgay!1`, nhưng mặc
# định đó NẰM CÔNG KHAI TRONG GIT (xem scripts/staff-bootstrap.ts) nên tuyệt
# đối không được dùng ở production (Task 21).
# STAFF_OWNER_PASSWORD=

# Tên hiển thị của chủ shop, dùng cho `bun run staff:bootstrap`. Không bắt
# buộc — mặc định "Chủ shop".
# STAFF_OWNER_NAME=
