{
  "name": "v9-motor-rental",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "dev": "bun --env-file=.env run --filter '*' dev",
    "build": "bun --env-file=.env run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck && ./node_modules/.bin/tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "bun run --filter @v9/db generate",
    "db:custom": "bun run --filter @v9/db custom",
    "db:migrate": "bun --env-file=.env packages/db/scripts/migrate.ts",
    "directus:setup": "bun --env-file=.env scripts/directus-setup.ts",
    "staff:bootstrap": "bun --env-file=.env scripts/staff-bootstrap.ts",
    "bench": "bun run apps/api/scripts/bench.ts",
    "seed:dev": "bun --env-file=.env ./scripts/seed-dev.ts"
  },
  "dependencies": {
    "supertokens-node": "24.0.3"
  },
  "devDependencies": {
    "@cspell/dict-vi-vn": "3.0.6",
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "20.13.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.10",
    "@types/react-dom": "19.2.5",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-plugin-boundaries": "7.1.0",
    "happy-dom": "20.13.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
